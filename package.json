{
  "name": "nest-vite-template",
  "description": "全栈模板",
  "private": true,
  "version": "1.0.20",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n service,frontend -c blue,green \"npm --prefix ./service run start:dev\" \"npm --prefix ./frontend run dev\"",
    "build": "node ./build.ts",
    "buildDocker": "node ./dockerBuild.ts",
    "install:all": "pnpm install && pnpm -C ./service install && pnpm -C ./frontend install",
    "dev:frontend": "npm --prefix ./frontend run dev",
    "dev:service": "npm --prefix ./service run start:dev",
    "lint": "npm run lint:frontend && npm run lint:service",
    "lint:frontend": "node ./node_modules/eslint/bin/eslint.js --config ./eslint.config.js \"frontend/**/*.{js,jsx,ts,tsx}\"",
    "lint:service": "node ./node_modules/eslint/bin/eslint.js --config ./eslint.config.js \"service/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --config ./prettier.config.mjs --ignore-path ./.prettierignore --write ./frontend \"service/{src,test}/**/*.ts\"",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --config ./prettier.config.mjs --ignore-path ./.prettierignore --check ./frontend \"service/{src,test}/**/*.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.30.1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lodash": "^4.17.23",
    "shelljs": "^0.10.0"
  }
}
