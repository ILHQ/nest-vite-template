# 是否同时输出日志到控制台，默认 `false`。
LOG_TO_CONSOLE=false
# `/api` 代理目标地址，默认指向本地测试地址。
PROXY_API=http://localhost:4000/test
# 数据库连接 URL
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/nest_vite_template_prod?schema=public
# 数据库连接池最大连接数
DB_POOL_MAX=20
# 数据库连接池最小连接数
DB_POOL_MIN=2
# 数据库连接空闲超时时间
DB_IDLE_TIMEOUT_MS=10000
# 数据库连接获取超时时间
DB_CONNECTION_TIMEOUT_MS=5000
# 数据库连接最大Lifetime时间
DB_MAX_LIFETIME_MS=0
# 数据库连接是否允许在空闲时退出
DB_ALLOW_EXIT_ON_IDLE=false
# 数据库连接是否使用 SSL
DB_SSL=true
