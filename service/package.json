{
  "name": "service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:development": "NODE_ENV=development node ./scripts/start-nest-dev.cjs start --watch",
    "dev:production": "NODE_ENV=production node ./scripts/start-nest-dev.cjs start --watch",
    "build:development": "NODE_ENV=development nest build && tsc-alias -p tsconfig.json",
    "build:production": "NODE_ENV=production nest build && tsc-alias -p tsconfig.json",
    "start:development": "NODE_ENV=development IS_BUILD=true node dist/src/main",
    "start:production": "NODE_ENV=production IS_BUILD=true node dist/src/main",
    "dev:development:debug": "NODE_ENV=development node ./scripts/start-nest-dev.cjs start --debug --watch",
    "postinstall": "node ./scripts/prisma-generate.cjs",
    "test": "jest --config ./jest.config.cjs",
    "test:watch": "jest --config ./jest.config.cjs --watch",
    "test:cov": "jest --config ./jest.config.cjs --coverage",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.cjs",
    "db:generate": "node ./scripts/prisma-generate.cjs --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "ejs": "^3.1.10",
    "fs-extra": "^11.3.4",
    "http-proxy-middleware": "^3.0.5",
    "lodash": "^4.17.21",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "prisma": "^7.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
