generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TestSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model geom {
  id       Int                      @id @default(autoincrement())
  name     String?
  geometry Unsupported("geometry")?
}
