# 是否同时输出日志到控制台，默认 `false`。
LOG_TO_CONSOLE=true
# `/api` 代理目标地址，默认指向本地测试地址。
PROXY_API=http://localhost:4000/test
# 数据库连接 URL，默认指向本地 PostgreSQL 数据库。
DATABASE_URL=postgresql://localhost:5432/postgres
# 数据库连接池最大连接数，默认 10。
DB_POOL_MAX=10
# 数据库连接池最小连接数，默认 0。
DB_POOL_MIN=0
# 数据库连接空闲超时时间，默认 10000 毫秒。
DB_IDLE_TIMEOUT_MS=10000
# 数据库连接获取超时时间，默认 5000 毫秒。
DB_CONNECTION_TIMEOUT_MS=5000
# 数据库连接最大Lifetime时间，默认 0 毫秒。
DB_MAX_LIFETIME_MS=0
# 数据库连接是否允许在空闲时退出，默认 `false`。
DB_ALLOW_EXIT_ON_IDLE=false
# 数据库连接是否使用 SSL，默认 `false`。
DB_SSL=false
# Redis 连接 URL
REDIS_URL=redis://localhost:6379
